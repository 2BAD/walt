# Copy to .env and fill in. Never commit the real .env.

# Option 1: one-off token.
WALLET_TOKEN=

# Option 2: automatic tokens over MTProto.
# Create an application at https://my.telegram.org to get the id and hash,
# then run `pnpm login:telegram` once to print the session string.
TG_API_ID=
TG_API_HASH=
WALLET_TG_SESSION=

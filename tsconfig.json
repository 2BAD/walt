{
  "extends": "@2bad/tsconfig",
  "include": ["source/**/*", "examples/**/*", "scripts/**/*", "vitest.config.ts"],
  "compilerOptions": {
    "target": "esnext",
    "outDir": "build",
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "~/*": ["./source/*"],
      "@2bad/walt": ["./source/index.ts"]
    }
  }
}
